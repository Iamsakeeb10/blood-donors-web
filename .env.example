# Firebase web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App Check (reCAPTCHA v3 site key). Leave empty to run without App Check in dev.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Canonical public URL, used in share links (no trailing slash).
# Example: https://blood-donors.example.vercel.app
NEXT_PUBLIC_SITE_URL=

# Admin contact (email). Defaults to shakibshovon.10@gmail.com
NEXT_PUBLIC_ADMIN_EMAIL=
NEXT_PUBLIC_ADMIN_CONTACT_HREF=
NEXT_PUBLIC_ADMIN_CONTACT_LABEL=যোগাযোগ
